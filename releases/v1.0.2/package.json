{
    "name":  "@local/conversation-voice",
    "version":  "1.0.2",
    "private":  true,
    "type":  "module",
    "description":  "Plays a chime and reads a short spoken summary (30 characters by default, about 1.5x normal speed) of what the finished turn accomplished after each conversation turn ends.",
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.md",
                  "INSTALL.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            }
}
